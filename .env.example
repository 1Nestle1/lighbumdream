# --- API ---
DATABASE_URL=postgres://lightbulb:lightbulb@localhost:5433/lightbulb
API_PORT=3001
# Where magic links point to (the web app).
WEB_ORIGIN=http://localhost:5173

# --- Folder suggestions ---
# Leave empty to use the offline heuristic suggester.
ANTHROPIC_API_KEY=
SUGGEST_MODEL=claude-opus-5

# --- Agents ---
# Cloud agents need ANTHROPIC_API_KEY. Set CLOUD_AGENTS=false to offer only users' own computers.
CLOUD_AGENTS=true
AGENT_MODEL=claude-opus-5
# Hard spending cap per cloud build (USD) and cloud builds per user per day.
CLOUD_BUILD_BUDGET_USD=5
CLOUD_BUILDS_PER_DAY=3

# --- Integrations (users' own API keys and GitHub tokens) ---
# Long random string that encrypts stored keys. Required in production; created automatically in development.
SECRETS_KEY=

# --- Email (magic links) ---
# Leave empty in development: the link is printed to the API log and shown in the UI.
SMTP_URL=
MAIL_FROM="Lightbulb <no-reply@lightbulb.local>"

# --- Files (photos and attachments on idea pages) ---
# Local folder for uploads; mount a volume here in production.
DATA_DIR=data

# --- Voice (offline, self-hosted whisper.cpp from docker-compose) ---
WHISPER_URL=http://127.0.0.1:8081
# Model the whisper container downloads on first start: base, small, medium, large-v3-turbo
WHISPER_MODEL=base

# --- Telegram bot (optional) ---
# Create a bot with @BotFather and paste its token. Without WEBHOOK_URL the bot uses long polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
