{
  "name": "@lightbulb/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Runs Lightbulb ideas with the coding agents on your computer",
  "type": "module",
  "bin": {
    "lightbulb": "dist/lightbulb.cjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lightbulb/shared": "*",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
